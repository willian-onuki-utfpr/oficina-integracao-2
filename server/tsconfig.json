{
  // Visit https://aka.ms/tsconfig to read more about this file
	"compilerOptions": {
		"target": "es6",
		"module": "commonjs",
		"outDir": "build",
		"strict": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ESNext.String"],
		"sourceMap": true
	},
}
